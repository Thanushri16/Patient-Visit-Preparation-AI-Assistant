OPENAI_API_KEY=your_openai_api_key_here

# Iteration 3 RAG knowledge store. Matches docker-compose.yml.
# Leave unset to run the app without RAG: the knowledge branch degrades to the
# curated answers in src/guidance.py, and the intake chain is unaffected.
DATABASE_URL=postgresql://healthcare:healthcare_local_dev@localhost:5433/healthcare_rag

# Embedding model. See EMBEDDING_PROFILES in src/rag/config.py.
#   openai-small (1536d, default) | openai-large (3072d)
# Changing this changes the vector width, which means dropping the volume and
# re-ingesting.
EMBEDDING_PROFILE=openai-small
